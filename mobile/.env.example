# Dew mobile — PUBLIC Supabase config. Safe to ship in the client; Row-Level Security is what
# actually protects your data. Copy this file to `.env` and fill in the anon key.
#   Supabase → Project Settings → API → Project URL + anon/public key ("Publishable key")
# NEVER put the service_role / secret key here — it bypasses RLS.
EXPO_PUBLIC_SUPABASE_URL=https://vpwsibyhkyfxqzvxvznw.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-your-anon-public-key-here
